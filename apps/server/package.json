{
  "name": "@nibleaf/server",
  "license": "AGPL-3.0-only",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": {
      "types": "./dist/rpc.d.mts",
      "default": "./dist/rpc.mjs"
    }
  },
  "scripts": {
    "dev": "pnpm run with-env tsx watch --clear-screen=false src/index.ts",
    "build": "tsdown",
    "start": "node ./dist/index.mjs",
    "with-env": "dotenv -e ../../.env --",
    "seed": "pnpm with-env tsx ./src/database/seed/index.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/standard-validator": "^0.4.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@nibleaf/auth": "workspace:*",
    "@nibleaf/bullmq": "workspace:*",
    "@nibleaf/clickhouse": "workspace:*",
    "@nibleaf/database": "workspace:*",
    "@nibleaf/email": "workspace:*",
    "@nibleaf/i18n": "workspace:*",
    "@nibleaf/logger": "workspace:*",
    "@nibleaf/qdrant": "workspace:*",
    "@nibleaf/search": "workspace:*",
    "@nibleaf/shared": "workspace:*",
    "@nibleaf/storage": "workspace:*",
    "@nibleaf/usage": "workspace:*",
    "@nibleaf/validators": "workspace:*",
    "@openrouter/sdk": "1.3.33",
    "@scalar/hono-api-reference": "^0.12.6",
    "@scalar/json-magic": "0.15.2",
    "@scalar/openapi-parser": "^0.29.7",
    "@slack/webhook": "8.0.2",
    "@t3-oss/env-core": "^0.13.11",
    "@tryghost/kg-lexical-html-renderer": "1.5.1",
    "@tryghost/kg-mobiledoc-html-renderer": "7.2.3",
    "diff": "^9.0.0",
    "fflate": "^0.8.2",
    "got": "16.0.0",
    "hono": "^4.13.9",
    "hono-openapi": "1.3.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "octokit": "5.0.5",
    "quansync": "0.2.11",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nibleaf/tsconfig": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/turndown": "^5.0.6",
    "dotenv-cli": "^11.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
