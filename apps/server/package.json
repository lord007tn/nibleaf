{
  "name": "@nibleaf/server",
  "license": "AGPL-3.0-only",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": {
      "types": "./dist/rpc.d.mts",
      "default": "./dist/rpc.mjs"
    }
  },
  "scripts": {
    "dev": "pnpm run with-env tsx watch --clear-screen=false src/index.ts",
    "build": "tsdown",
    "start": "node ./dist/index.mjs",
    "with-env": "dotenv -e ../../.env --",
    "seed": "pnpm with-env tsx ./src/database/seed/index.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "fixtures:record-docs": "node src/actions/importers/fixtures/record-nibleaf-docs.mjs",
    "org:merge": "tsx src/scripts/org-merge.ts",
    "eval:drafts": "tsx src/scripts/evaluate-drafts.ts",
    "search:reindex-all": "tsx src/scripts/reindex-search.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/server": "2.4.0",
    "@nibleaf/auth": "workspace:*",
    "@nibleaf/bullmq": "workspace:*",
    "@nibleaf/clickhouse": "workspace:*",
    "@nibleaf/database": "workspace:*",
    "@nibleaf/email": "workspace:*",
    "@nibleaf/i18n": "workspace:*",
    "@nibleaf/logger": "workspace:*",
    "@nibleaf/qdrant": "workspace:*",
    "@nibleaf/search": "workspace:*",
    "@nibleaf/shared": "workspace:*",
    "@nibleaf/storage": "workspace:*",
    "@nibleaf/usage": "workspace:*",
    "@nibleaf/validators": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.18",
    "@scalar/json-magic": "0.18.0",
    "@scalar/openapi-parser": "^0.29.20",
    "@slack/webhook": "8.0.2",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/ai": "1.0.0",
    "@tryghost/kg-lexical-html-renderer": "1.5.0",
    "@tryghost/kg-mobiledoc-html-renderer": "7.2.3",
    "diff": "^9.0.0",
    "fflate": "^0.8.2",
    "got": "16.2.0",
    "hono": "^4.13.16",
    "hono-openapi": "1.5.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "octokit": "5.0.5",
    "quansync": "0.2.11",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nibleaf/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "dotenv-cli": "^11.1.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
