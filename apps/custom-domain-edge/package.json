{
  "name": "@nibleaf/custom-domain-edge",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build",
    "dev": "cf dev",
    "upload": "cf workers versions create --prebuilt --mode production",
    "deploy": "cf workers deployments create --worker nibleaf-custom-domain-edge --strategy percentage",
    "test": "vitest run --config vitest.config.ts --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "cf workers types && tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@nibleaf/tsconfig": "workspace:*",
    "cf": "1.0.0-beta.28",
    "typescript": "^7.0.2",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  }
}
