{
  "name": "@nibleaf/worker",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run with-env tsx watch --clear-screen=false src/index.ts",
    "build": "tsdown",
    "start": "node ./dist/index.mjs",
    "with-env": "dotenv -e ../../.env --",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@getworkbench/hono": "^0.9.1",
    "@hono/node-server": "^2.0.8",
    "@nibleaf/bullmq": "workspace:*",
    "@nibleaf/database": "workspace:*",
    "@nibleaf/logger": "workspace:*",
    "@nibleaf/shared": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "bullmq": "^5.80.0",
    "hono": "^4.12.29",
    "nodemailer": "^6.9.0",
    "postmark": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nibleaf/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.0",
    "dotenv-cli": "^11.0.0",
    "tsdown": "^0.22.4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2"
  }
}
