{
  "name": "Nibleaf Documentation",
  "short_name": "Nibleaf Docs",
  "description": "Documentation for Nibleaf, the open-source, self-hostable documentation platform.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#8a4b2e",
  "background_color": "#fbf7ee",
