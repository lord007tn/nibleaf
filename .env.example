# ──────────────────────────────────────────────────────────────────────────
# Midad — open-source documentation platform. Copy to `.env` for local dev.
# Defaults below line up with docker-compose.dev.yml (works offline once the
# infra containers are up).  Ports are picked to avoid clashing with other
# local stacks (app 4310 / api 4311 / worker 4312 / www 4313).
# ──────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
APP_NAME=Midad
API_PORT=4311
API_URL=http://localhost:4311
APP_URL=http://localhost:4310
WWW_URL=http://localhost:4313
WORKER_PORT=4312
SERVICE_NAME=midad-api
REGION=local
PINO_LOG_LEVEL=debug

# Frontend (Vite) — cross-app links + the same-origin /api proxy target.
# App dev ports are fixed in each app's vite config: app 4310, www 4313.
VITE_API_URL=http://localhost:4311
VITE_APP_URL=http://localhost:4310
VITE_WWW_URL=http://localhost:4313
VITE_GITHUB_URL=https://github.com/lord007tn/midad
# Public wildcard/base domain for free project subdomains. In production create
# a wildcard DNS record, for example `*.docs.example.com -> your app ingress`.
# MUST stay aligned with SITE_BASE_DOMAIN below: this is the client URL-preview
# base, and the server resolves subdomains off the same value. If they differ,
# the client advertises a host the server never resolves.
VITE_SITE_BASE_DOMAIN=docs.example.com

# Auth (better-auth). BETTER_AUTH_URL is the dashboard origin: the browser only
# ever talks to the app, which proxies /api to the server, so cookies stay
# first-party. Generate a real secret with: openssl rand -hex 32
#
# Configuration: production secrets — the value below is a DEV-ONLY placeholder.
# When NODE_ENV=production the container entrypoint refuses to start if
# BETTER_AUTH_SECRET is empty or a known weak default. Also set strong values for
# POSTGRES_PASSWORD and STORAGE_SECRET_KEY for standard Compose, or
# STORAGE_SECRET_ACCESS_KEY when using Coolify/raw S3 env names. See DEPLOYMENT.md.
BETTER_AUTH_SECRET=dev-secret-change-me-please-32chars-min
BETTER_AUTH_URL=http://localhost:4310
TRUSTED_ORIGINS=http://localhost:4310,http://localhost:4311,http://localhost:4313,http://localhost:4315
# Require a verified email before sign-in (recommended for public instances).
# Needs SMTP_URL configured so the verification email can actually be delivered.
REQUIRE_EMAIL_VERIFICATION=false

# CORS origins the API will accept credentialed requests from.
CORS_ALLOWED_ORIGINS=http://localhost:4310,http://localhost:4313,http://localhost:4315

# Published-site domains
# SITE_BASE_DOMAIN powers free project subdomains, e.g. <project>.docs.example.com.
# MUST stay aligned with VITE_SITE_BASE_DOMAIN above (client URL-preview base ==
# server subdomain base) or the client will advertise unresolvable hosts.
# CUSTOM_DOMAIN_CNAME_TARGET is the host shown in custom-domain DNS instructions —
# set it to YOUR ingress host. Leave blank to fall back to SITE_BASE_DOMAIN (or the
# app host). Do NOT point it at a domain you don't control.
SITE_BASE_DOMAIN=docs.example.com
# CUSTOM_DOMAIN_CNAME_TARGET=ingress.example.com

# Postgres (Prisma) — host port 5442 to avoid clashing with a local 5432/5440.
POSTGRES_URL=postgresql://midad:midad@localhost:5442/midad

# Dragonfly (Redis-compatible, BullMQ) — host port 6381 to avoid clashing with a local 6379.
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0
# Hash-tag BullMQ queue names, as recommended for Dragonfly --lock_on_hashtags.
QUEUE_CLUSTER=true

# Queue concurrency
PUBLISH_CONCURRENCY=2
SEARCH_CONCURRENCY=4
EMAIL_CONCURRENCY=3
ANALYTICS_CONCURRENCY=10

# Worker queue allowlist (empty = run every queue in one worker process).
WORKER_QUEUES=
# Optional basic-auth for the worker's BullMQ dashboard at /jobs.
WORKBENCH_USER=
WORKBENCH_PASS=

# Object storage (S3-compatible). LOCAL default = maxio (docker-compose.dev.yml).
# Works unchanged with any S3-compatible store (maxio, Cloudflare R2, AWS S3, B2, MinIO).
STORAGE_PROVIDER=maxio
STORAGE_ENDPOINT=http://localhost:9300
# Browser-reachable endpoint for signing upload/download URLs. In docker the
# server reaches maxio at http://maxio:9000 internally, but presigned URLs must
# point at a host the browser can reach (this).
STORAGE_PUBLIC_ENDPOINT=http://localhost:9300
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=midadadmin
STORAGE_SECRET_ACCESS_KEY=midadadmin123
STORAGE_BUCKET=midad
STORAGE_FORCE_PATH_STYLE=true
# Optional public/CDN base for serving uploaded assets directly.
STORAGE_PUBLIC_URL=http://localhost:9300/midad
CDN_URL=
# Standard production Compose aliases for the same browser-facing values:
# PUBLIC_STORAGE_ENDPOINT=https://storage.your-domain.com
# PUBLIC_STORAGE_URL=https://cdn.your-domain.com/midad
# Browser origins allowed to upload directly to the bucket (applied as the bucket
# CORS policy on API boot). Comma-separated; the dashboard origin(s).
STORAGE_CORS_ALLOWED_ORIGINS=http://localhost:4310
STORAGE_AUTO_CORS=true

# --- Cloudflare R2 (production alternative) — use instead of the maxio block ---
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=<r2_access_key_id>
# STORAGE_SECRET_ACCESS_KEY=<r2_secret_access_key>
# STORAGE_BUCKET=<r2_bucket>
# CDN_URL=https://cdn.your-domain.com

# Search (Orama) — full-text + fuzzy, built in-process from published pages.
# Index is cached in memory keyed by deployment version and rebuilt on publish.
SEARCH_FUZZY_TOLERANCE=1

# Email (optional; logs to console in dev when SMTP_URL is empty)
EMAIL_FROM=midad@localhost
SMTP_URL=

# Public docs base: where published doc sites are served. In dev the app serves
# them at /sites/:slug; in production set this to your docs domain.
DOCS_PUBLIC_URL=http://localhost:4310/sites
