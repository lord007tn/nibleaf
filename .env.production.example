# ──────────────────────────────────────────────────────────────────────────
# Nibleaf — production environment for docker-compose.prod.yml (pull-based).
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml up -d
#
# Every variable docker-compose.prod.yml interpolates is listed here. Values
# marked REQUIRED make `docker compose` fail fast with a clear error if unset.
# Never commit your filled-in .env.
# ──────────────────────────────────────────────────────────────────────────

# ── Image ─────────────────────────────────────────────────────────────────
# Pin to a release tag from https://github.com/lord007tn/nibleaf/releases.
# Upgrades = bump this, `docker compose -f docker-compose.prod.yml pull`,
# then `up -d` (migrations run automatically). See:
# https://docs.nibleaf.com/self-hosting/backups-upgrades
NIBLEAF_VERSION=v0.1.1

# ── Public origins ────────────────────────────────────────────────────────
# REQUIRED. The browser-facing dashboard origin (behind your TLS proxy). The
# app proxies /api to the server internally, so this is the only web origin
# most deployments need.
APP_URL=https://docs.example.com
# Public admin-console origin when the admin service is exposed. Password
# sign-in is refused on this origin; administrators authenticate by email OTP.
ADMIN_URL=https://admin.example.com

# Host interface + port the app container binds on this machine. Keep the
# 127.0.0.1 default when your reverse proxy runs on the same host; set
# NIBLEAF_BIND=0.0.0.0 only when something external terminates TLS.
NIBLEAF_BIND=127.0.0.1
APP_PORT=4310

# Optional overrides — both default to APP_URL. Comma-separated lists.
# BETTER_AUTH_URL=https://docs.example.com
# TRUSTED_ORIGINS=https://docs.example.com
# CORS_ALLOWED_ORIGINS=https://docs.example.com

# ── Published docs domains ────────────────────────────────────────────────
# Free project subdomains: <project>.<SITE_BASE_DOMAIN>. Needs a wildcard DNS
# record (*.docs.example.com) plus a wildcard vhost/TLS cert at your proxy —
# see https://docs.nibleaf.com/publish-and-measure/domains-seo.
# Leave empty to disable subdomain publishing.
SITE_BASE_DOMAIN=docs.example.com
# Host your customers CNAME their custom docs domains to. Set it to a host
# YOU control (usually your ingress). Falls back to SITE_BASE_DOMAIN if empty.
CUSTOM_DOMAIN_CNAME_TARGET=cname.docs.example.com

# ── Secrets (REQUIRED) ────────────────────────────────────────────────────
# Generate strong values — the stack refuses to boot with weak/empty secrets:
#   openssl rand -hex 32      # BETTER_AUTH_SECRET / INTERNAL_API_SECRET
#   openssl rand -base64 24   # POSTGRES_PASSWORD / STORAGE_SECRET_ACCESS_KEY
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
# Shared secret between the app's SSR proxy and the API. Enables accurate
# per-visitor rate limiting for published docs traffic (without it the hint
# header is ignored — safe, but SSR traffic shares the app container's bucket).
INTERNAL_API_SECRET=

# ── Object storage (S3-compatible) ────────────────────────────────────────
# Defaults use the bundled maxio container. Any S3-compatible store works
# (Cloudflare R2, AWS S3, Backblaze B2, MinIO). See:
# https://docs.nibleaf.com/self-hosting/configuration
STORAGE_PROVIDER=maxio
# Internal (server -> storage) endpoint. Leave unset for bundled maxio; set
# only for an external store, e.g. https://<account>.r2.cloudflarestorage.com
# STORAGE_ENDPOINT=
# REQUIRED. Browser-reachable storage origin — presigned upload/download URLs
# are signed against it. With bundled maxio, route this host to maxio:9000 at
# your reverse proxy.
STORAGE_PUBLIC_ENDPOINT=https://storage.example.com
# REQUIRED. Credentials for the bundled maxio (it is created with these) or
# your external bucket's access key pair.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=nibleaf
STORAGE_REGION=auto
# true for maxio/R2/MinIO; false for AWS S3.
STORAGE_FORCE_PATH_STYLE=true
# Public base URL for serving uploaded assets (bucket or CDN). Recommended:
STORAGE_PUBLIC_URL=https://storage.example.com/nibleaf
# Browser origins allowed to upload directly to the bucket (defaults to APP_URL).
# STORAGE_CORS_ALLOWED_ORIGINS=https://docs.example.com
STORAGE_AUTO_CORS=true
# maxio console cookies require HTTPS by default; set false only for plain-HTTP testing.
MAXIO_SECURE_COOKIES=true

# ── Auth & sign-up policy ─────────────────────────────────────────────────
# Require a verified email before sign-in. Default TRUE for production —
# needs POSTMARK_API_KEY or SMTP_URL below so the mail can actually send.
# Set false for a private instance without email delivery.
REQUIRE_EMAIL_VERIFICATION=true
# Set true to close public registration (existing users can still sign in).
DISABLE_SIGNUP=false
# Optional Google OAuth sign-in.
# In Google Cloud, authorize APP_URL as a JavaScript origin and add:
# ${APP_URL}/api/auth/callback/google as the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email delivery ────────────────────────────────────────────────────────
# Postmark is preferred when POSTMARK_API_KEY is set; SMTP_URL is the generic
# fallback (smtp://user:pass@host:587). Without either, the worker only logs
# outgoing mail. EMAIL_FROM must be a sender your provider has verified.
EMAIL_FROM=Nibleaf <no-reply@example.com>
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM=
# Keep Open Tracking disabled on the corresponding Postmark server. Its server
# setting overrides the per-message privacy option used for auth emails.
SMTP_URL=

# ── AI writing assist (optional) ──────────────────────────────────────────
# Editor AI features stay off without a key.
OPENAI_API_KEY=
# Max AI-assist requests per workspace per day (0 disables AI drafting).
AI_DAILY_LIMIT=50

# ── Rate limiting ─────────────────────────────────────────────────────────
# Per-IP request budget for the public site-serving API (requests/minute).
RATE_LIMIT_PUBLIC_PER_MIN=300
# Number of PUBLIC proxy hops your edge appends to X-Forwarded-For. Keep this
# at 0 unless your ingress strips untrusted forwarded headers and you have
# captured its real chain. For Cloudflare -> Traefik, configure Traefik to
# trust Cloudflare IP ranges first; its default append behaviour commonly makes
# this 1. Private proxies are skipped automatically. Setting this too high lets
# clients evade rate limits.
TRUSTED_PROXY_HOPS=0

# ── Worker ops dashboard ──────────────────────────────────────────────────
# Background exports. The official image contains Chromium. If WORKER_QUEUES is
# set, include `export`; otherwise all queues run. Limits protect worker memory,
# tenant fairness, and presigned URL exposure.
EXPORT_CONCURRENCY=2
EXPORT_CHROMIUM_PATH=/usr/bin/chromium-browser
EXPORT_MAX_ACTIVE_PER_PROJECT=3
EXPORT_MAX_DAILY_PER_PROJECT=20
EXPORT_MAX_PAGES=5000
EXPORT_MAX_SNAPSHOT_BYTES=52428800
EXPORT_MAX_ASSET_BYTES=262144000
EXPORT_MANUAL_RETENTION_DAYS=7
EXPORT_DOWNLOAD_TTL_SECONDS=300

# Basic auth for the BullMQ dashboard at worker :4312/jobs. The port is not
# published by docker-compose.prod.yml, but set both anyway — WITHOUT them the
# dashboard is unauthenticated to anything that can reach the worker.
WORKBENCH_USER=
WORKBENCH_PASS=

# Required to enable two-way Git authoring. Generate independently:
# openssl rand -base64 32  (credential encryption)
# openssl rand -hex 32     (API/worker authentication)
GIT_CREDENTIAL_ENCRYPTION_KEY=
GIT_WORKER_SECRET=
GIT_CONCURRENCY=2

# ── Misc ──────────────────────────────────────────────────────────────────
# Seed demo content on first migrate (leave false in production).
NIBLEAF_RUN_SEED=false

# Graceful deploy drain: the API stops advertising readiness, then waits for
# in-flight requests before Docker sends SIGKILL. Keep grace > timeout.
SERVER_SHUTDOWN_TIMEOUT_MS=25000
NIBLEAF_SHUTDOWN_GRACE=30s
