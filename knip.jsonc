{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["apps/docs/.source/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/split-ghost-by-language.mjs"]
    },
    "apps/server": {
      "entry": ["src/scripts/grant-admin.ts"],
      "ignoreDependencies": ["quansync"],
      // Public cross-feature CAS boundary consumed by independently merged
      // theme/add-on branches; this owning PR intentionally lands it first.
      "ignoreIssues": { "src/actions/project-config.ts": ["exports"] }
    },
    "packages/database": {
      "ignoreDependencies": ["@prisma/client"]
    },
    "packages/tsconfig": {
      "ignoreDependencies": ["vite"]
    }
  }
}
