{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "apps/docs/.source/**",
    "apps/app/public/guides/fixtures/markdown-round-trip.mdx"
  ],
  "workspaces": {
    "apps/custom-domain-edge": {
      "entry": ["src/index.ts", "cloudflare.config.ts"],
      "project": ["src/**/*.ts"]
    },
    ".": {
      "entry": [
        "tests/integration/editor-p2/browser.mjs",
        "changelogithub.config.mjs",
        "scripts/docker-context-smoke.mjs",
        "scripts/graceful-web-service.mjs",
        "scripts/migration-safety.mjs",
        "scripts/runtime-image-audit.mjs",
        "scripts/site-preview-mock.mjs",
        "scripts/site-preview-shots.mjs",
        "scripts/split-ghost-by-language.mjs",
        "tests/integration/delete-inbound-links/browser.mjs",
        "tests/integration/editor-paste-and-title/browser.mjs",
        "tests/integration/overview-first-publish/browser.mjs",
        "tests/integration/site-owner-addresses/browser.mjs",
        "tests/integration/ssr-locale-direction/capture.mjs"
      ]
    },
    "apps/server": {
      "entry": ["src/scripts/grant-admin.ts"],
      "ignoreDependencies": ["quansync"]
    },
    "apps/app": {
      "entry": [
        "scripts/delete-inbound-links.fixture.tsx",
        "scripts/editor-paste-and-title.fixture.tsx",
        "scripts/overview-first-publish.fixture.tsx",
        "scripts/site-owner-addresses.fixture.tsx"
      ]
    },
    "packages/database": {
      "ignoreDependencies": ["@prisma/client"]
    },
    "packages/i18n": {
      // Loaded from project.inlang/settings.json by the translation compiler.
      "ignoreDependencies": [
        "@inlang/plugin-message-format",
        "@inlang/plugin-m-function-matcher"
      ]
    },
    "packages/shared": {
      // Golden-test inputs read by path (public-markdown-golden.test.ts). The
      // remark-mdx dependency makes knip treat .mdx as source files.
      "ignore": ["src/__fixtures__/**"]
    },
    "packages/tsconfig": {
      "ignoreDependencies": ["vite"]
    }
  }
}
