# Source and configuration files use LF on every platform. This keeps Biome
# results identical on Windows and Linux and prevents CRLF shebang failures in
# containers.
* text=auto eol=lf

*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Never apply text conversion to binary assets.
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
