{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env.*local", ".env"],
  "ui": "stream",
  "concurrency": "15",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^setup", "^build"],
      "env": ["BUNDLE_ANALYZE", "MARKETING_GITHUB_STARS"],
      "outputs": [
        "dist/**",
        ".output/**",
        ".nitro/**",
        ".bundle-analysis/**",
        "src/generated/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "setup": {
      "dependsOn": ["^setup"],
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["setup", "^setup", "^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
