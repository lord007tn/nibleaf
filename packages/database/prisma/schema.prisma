// Midad — documentation platform database schema.
// Auth tables (User/Session/Account/Verification/Organization/Member/Invitation)
// follow better-auth conventions. Domain tables model documentation sites:
// Project → Page tree → Deployment snapshots, plus Domain, ApiKey, Asset,
// Comment, and AnalyticsEvent.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

// ─── Auth (better-auth) ──────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
  comments    Comment[]

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Organization (workspace) ────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members     Member[]
  invitations Invitation[]
  projects    Project[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// ─── Documentation domain ──────────────────────────────────────────────────—

enum PageKind {
  PAGE
  GROUP
}

enum DeploymentStatus {
  PENDING
  BUILDING
  READY
  FAILED
}

/// Reading direction for a project language (drives `dir` on the editor + site).
enum TextDirection {
  LTR
  RTL
}

/// A documentation site.
model Project {
  id             String       @id @default(cuid())
  // Each site owns its own Organization (1:1) — that org IS the site's member
  // boundary, so members/roles/invitations are per-site. See provisionSiteOrg.
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  icon           String?
  // Branding / appearance
  color          String       @default("#5546e8")
  logoUrl        String?
  faviconUrl     String?
  /// Legacy theme config (superseded by `config`); kept for back-compat.
  theme          Json?
  /// Full site configuration: { visibility, branding, styling, typography,
  /// navbar, footer, banner, seo, search, analytics, redirects, variables }.
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  languages       Language[]
  branches        Branch[]
  pages           Page[]
  deployments     Deployment[]
  domains         Domain[]
  apiKeys         ApiKey[]
  assets          Asset[]
  comments        Comment[]
  analyticsEvents AnalyticsEvent[]

  @@unique([organizationId, slug])
  @@unique([slug])
  @@map("project")
}

/// A content branch within a project (git-style, DB-backed). `main` is the
/// default branch the published site is built from; other branches are isolated
/// drafts you can edit and preview, then merge into main.
model Branch {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages Page[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("branch")
}

/// A language/locale a project's docs are authored in. Each language owns its
/// own page tree; one language per project is the default.
model Language {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code      String
  label     String
  direction TextDirection @default(LTR)
  isDefault Boolean       @default(false)
  position  Int           @default(0)
  /// Per-language SEO + behaviour overrides: { seo: { metaTitle, metaDescription,
  /// socialImage, allowIndex }, behaviour: {...} }. Layered between project.config
  /// and page.config when rendering the live site.
  config    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  pages Page[]

  @@unique([projectId, code])
  @@index([projectId])
  @@map("language")
}

/// A node in a project's documentation tree. `kind = GROUP` is a folder with no
/// content; `kind = PAGE` is a renderable MDX page. `path` is the full slug path.
/// Pages belong to a `Language`; the tree is scoped per (project, language).
model Page {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageId  String?
  language    Language? @relation(fields: [languageId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Page?     @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]    @relation("PageTree")
  kind        PageKind  @default(PAGE)
  title       String
  slug        String
  path        String
  icon        String?
  description String?
  content     String    @default("")
  /// Per-page overrides: { seo: { metaTitle, metaDescription, ogImage,
  /// canonicalUrl, noindex }, sidebarTitle, mode: 'default'|'wide'|'center',
  /// hideToc }. Layered over language.config + project.config on the live site.
  config      Json?
  /// Links the same logical page across languages whose slugs differ (e.g. EN
  /// "introduction-merged" ↔ AR "introduction"), so hreflang alternates pair up
  /// even when paths don't match. Shared by all language variants of one page.
  translationKey String?
  position    Int       @default(0)
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments Comment[]

  @@index([projectId, languageId, path])
  @@index([projectId, parentId])
  @@index([projectId, translationKey])
  @@index([languageId])
  @@index([branchId])
  @@map("page")
}

/// An immutable snapshot of a project's docs at publish time. The live site is
/// served from the latest READY deployment.
model Deployment {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       Int
  status        DeploymentStatus @default(PENDING)
  /// { project: {...}, pages: [...] } captured at publish time.
  snapshot      Json?
  pagesCount    Int              @default(0)
  commitMessage String?
  createdById   String?
  error         String?
  createdAt     DateTime         @default(now())
  completedAt   DateTime?

  @@unique([projectId, version])
  @@index([projectId, status])
  @@map("deployment")
}

model Domain {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain            String    @unique
  verified          Boolean   @default(false)
  verificationToken String
  isPrimary         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  verifiedAt        DateTime?

  @@index([projectId])
  @@map("domain")
}

model ApiKey {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  hashedSecret String    @unique
  lastFour     String
  scopes       String[]
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  @@index([projectId])
  @@map("api_key")
}

model Asset {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key         String   @unique
  url         String
  contentType String
  size        Int
  createdById String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@map("asset")
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  resolved  Boolean  @default(false)
  /// Figma-style anchor: which block/selection the comment is attached to.
  /// Shape: { quote: string, from?: number, to?: number } — `quote` (the anchored
  /// text) is the durable locator (re-found on load, since page content is Markdown
  /// with no stable node ids); from/to are creation-time position hints.
  anchor    Json?
  createdAt DateTime @default(now())

  @@index([projectId, pageId])
  @@map("comment")
}

/// Page views and search queries on published sites (powers the analytics tab).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String   @default("pageview") // "pageview" | "search" | "feedback"
  path      String?
  referrer  String?
  country   String?
  device    String?
  language  String? // active language code at view time (e.g. "en", "ar")
  sessionId String?
  query     String? // search query or feedback sentiment
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, type])
  @@map("analytics_event")
}
