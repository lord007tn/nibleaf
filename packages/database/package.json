{
  "name": "@nibleaf/database",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./src/index.ts"
    },
    "./keys": {
      "types": "./dist/keys.d.mts",
      "default": "./src/keys.ts"
    }
  },
  "scripts": {
    "build": "pnpm generate && tsdown",
    "with-env": "dotenv -e ../../.env --",
    "generate": "prisma generate",
    "migrate:dev": "pnpm with-env prisma migrate dev",
    "migrate:deploy": "pnpm with-env prisma migrate deploy",
    "smoke:addons-migration": "tsx ./scripts/addons-migration-smoke.ts",
    "push": "pnpm with-env prisma db push",
    "smoke": "tsx ./scripts/runtime-smoke.ts",
    "studio": "pnpm with-env prisma studio",
    "clean": "git clean -xdf .cache .turbo dist node_modules src/generated",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@t3-oss/env-core": "^0.13.11",
    "@nibleaf/usage": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nibleaf/tsconfig": "workspace:*",
    "@nibleaf/validators": "workspace:*",
    "@types/node": "^22.15.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "7.9.1",
    "tsx": "4.22.4",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
