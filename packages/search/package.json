{
  "name": "@nibleaf/search",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./keys": {
      "types": "./dist/keys.d.mts",
      "default": "./dist/keys.mjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.mts",
      "default": "./dist/workspace.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "bench": "vitest bench --run src/arabic.bench.ts",
    "eval:rag": "tsx scripts/evaluate-openrouter.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nibleaf/database": "workspace:*",
    "@nibleaf/i18n": "workspace:*",
    "@nibleaf/shared": "workspace:*",
    "@openrouter/sdk": "1.5.28",
    "@orama/orama": "^3.1.18",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-openai": "1.0.0",
    "openai": "7.47.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nibleaf/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
