{
  "name": "@nibleaf/i18n",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./locales": "./src/locales.ts",
    "./react": "./src/react.ts",
    "./scoped": "./src/scoped.ts",
    "./standalone": "./src/standalone.ts",
    "./email": "./src/email.ts",
    "./site": "./src/site.ts",
    "./site-chat": "./src/site-chat.ts",
    "./site-access": "./src/site-access.ts",
    "./site-content": "./src/site-content.ts",
    "./site-page-actions": "./src/site-page-actions.ts",
    "./site-search": "./src/site-search.ts",
    "./marketing": "./src/marketing.ts",
    "./locale-state": "./src/runtime.ts",
    "./request-locale": "./src/request-locale.ts",
    "./messages": "./src/paraglide/messages.js",
    "./messages/*": "./src/paraglide/messages/*.js",
    "./runtime": "./src/paraglide/runtime.js"
  },
  "scripts": {
    "setup": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --output-structure message-modules --emit-ts-declarations",
    "clean": "git clean -xdf .cache .turbo dist node_modules src/paraglide",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "dependencies": {
    "@inlang/paraglide-js": "3.2.0"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@inlang/plugin-m-function-matcher": "2.4.3",
    "@inlang/plugin-message-format": "4.6.0",
    "@nibleaf/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
