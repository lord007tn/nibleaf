diff --git a/index.js b/index.js
--- a/index.js
+++ b/index.js
@@ -1,9 +1,40 @@
 'use strict';
 
-var imageSize = require('image-size');
+var { imageSize } = require('image-size');
+var fs = require('node:fs');
 var path = require('node:path');
 
+// image-size v2 accepts buffers; Markdown image rendering must remain synchronous.
+// Optional image_size reads regular files only, with a hard 16 MiB allocation limit.
+// This replaces v1's 512 KiB prefix plus TIFF seek with one bounded file buffer,
+// retaining TIFF directories beyond the old prefix without unbounded reads.
+function imageSizeFromFile(filePath) {
+  const descriptor = fs.openSync(filePath, fs.constants.O_RDONLY | (fs.constants.O_NONBLOCK || 0));
+  try {
+    const stat = fs.fstatSync(descriptor);
+    if (!stat.isFile()) {
+      throw new TypeError('Image sizing requires a regular file');
+    }
+    if (stat.size <= 0) {
+      throw new Error('Empty file');
+    }
+    if (stat.size > 16 * 1024 * 1024) {
+      throw new RangeError('Image file exceeds the 16 MiB sizing limit');
+    }
+    const input = new Uint8Array(stat.size);
+    let offset = 0;
+    while (offset < input.length) {
+      const bytesRead = fs.readSync(descriptor, input, offset, input.length - offset, offset);
+      if (bytesRead === 0) break;
+      offset += bytesRead;
+    }
+    return imageSize(offset === input.length ? input : input.subarray(0, offset));
+  } finally {
+    fs.closeSync(descriptor);
+  }
+}
+
 function lazy_loading_plugin(md, mdOptions) {
   var defaultImageRenderer = md.renderer.rules.image;
 
   md.renderer.rules.image = function (tokens, idx, options, env, self) {
