{
  "name": "@midad/root",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "build:server": "turbo run build -F @midad/server...",
    "build:worker": "turbo run build -F @midad/worker...",
    "build:app": "turbo run build -F @midad/app...",
    "build:www": "turbo run build -F @midad/www...",
    "dev": "turbo watch dev -F @midad/server -F @midad/worker -F @midad/app",
    "dev:full": "turbo watch dev",
    "dev:server": "turbo watch dev -F @midad/server...",
    "dev:app": "turbo watch dev -F @midad/app...",
    "dev:www": "turbo watch dev -F @midad/www...",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "release:notes": "pnpm dlx changelogithub@14.0.0",
    "db:generate": "pnpm --filter @midad/database generate",
    "db:migrate": "pnpm --filter @midad/database migrate:dev",
    "db:deploy": "pnpm --filter @midad/database migrate:deploy",
    "db:push": "pnpm --filter @midad/database push",
    "db:seed": "pnpm --filter @midad/server seed",
    "db:studio": "pnpm --filter @midad/database studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@midad/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.9.16",
    "typescript": "^5.9.2",
    "unrun": "^0.3.1",
    "vitest": "^3.2.4"
  }
}
