{
  "name": "@nibleaf/root",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "sharp": "0.35.3",
      "undici": "7.29.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:server": "turbo run build -F @nibleaf/server...",
    "build:worker": "turbo run build -F @nibleaf/worker...",
    "build:app": "turbo run build -F @nibleaf/app...",
    "dev": "turbo watch dev -F @nibleaf/server -F @nibleaf/worker -F @nibleaf/app",
    "dev:full": "turbo watch dev",
    "dev:server": "turbo watch dev -F @nibleaf/server...",
    "dev:app": "turbo watch dev -F @nibleaf/app...",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:dead-code": "knip --files",
    "release:notes": "pnpm dlx changelogithub@14.0.0",
    "self-host:check": "node scripts/self-host-release.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "db:generate": "pnpm --filter @nibleaf/database generate",
    "db:migrate": "pnpm --filter @nibleaf/database migrate:dev",
    "db:deploy": "pnpm --filter @nibleaf/database migrate:deploy",
    "db:push": "pnpm --filter @nibleaf/database push",
    "db:seed": "pnpm --filter @nibleaf/server seed",
    "db:studio": "pnpm --filter @nibleaf/database studio",
    "analytics:migrate": "pnpm --filter @nibleaf/clickhouse migrate",
    "analytics:backfill": "tsx scripts/analytics-migration.ts backfill",
    "analytics:reconcile": "tsx scripts/analytics-migration.ts reconcile",
    "analytics:rollback": "tsx scripts/analytics-migration.ts rollback"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@nibleaf/clickhouse": "workspace:*",
    "@nibleaf/database": "workspace:*",
    "@nibleaf/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^11.0.0",
    "knip": "6.32.2",
    "turbo": "^2.9.16",
    "typescript": "^7.0.2",
    "tsx": "4.22.4",
    "unrun": "^0.3.1",
    "vitest": "^3.2.4"
  }
}
