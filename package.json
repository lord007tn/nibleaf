{
  "name": "@nibleaf/root",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils@>=4.0.0 <4.0.33": "4.0.33",
      "@tanstack/ai": "1.0.0",
      "@tanstack/ai-client": "1.0.0",
      "@tanstack/ai-event-client": "1.0.0",
      "@tanstack/ai-utils": "1.0.0",
      "@tanstack/openai-base": "1.0.0",
      "@tiptap/extension-bubble-menu": "3.30.4",
      "@tiptap/extension-floating-menu": "3.30.4",
      "@tiptap/y-tiptap": "3.0.7",
      "@tryghost/kg-default-nodes@2.1.5>html-minifier": "-",
      "@tryghost/kg-default-nodes@2.2.0>html-minifier": "-",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "deepmerge-ts": "8.0.2",
      "dompurify@>=3.0.0 <3.4.17": "3.4.17",
      "engine.io@>=6.0.0 <6.6.10": "6.6.10",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "glob@>=13.0.0 <14.0.2": "14.0.2",
      "hono@>=4.0.0 <4.13.16": "4.13.18",
      "http-cache-semantics@>=4.0.0 <4.3.0": "4.3.0",
      "katex@<0.18.2": "0.18.5",
      "markdown-it@>=14.0.0 <14.3.3": "14.3.3",
      "markdown-it-image-lazy-loading@2.0.1>image-size": "2.0.3",
      "mysql2": "3.23.1",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1",
      "next@>=16.0.0 <16.4.1": "16.4.1",
      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "qs": "6.16.1",
      "remark-mdx-frontmatter>toml": "5.0.1",
      "seroval@>=1.6.0 <1.6.11": "1.6.11",
      "sharp@>=0.35.0 <0.35.5": "0.35.5",
      "smol-toml@>=1.8.0 <1.9.0": "1.9.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "undici": "7.30.1",
      "vite@8.2.4>rolldown": "1.2.7",
      "vite@>=8.3.0 <8.3.3": "8.3.3",
      "zod@>=4.0.0 <4.6.7": "4.6.7"
    },
    "patchedDependencies": {
      "markdown-it-image-lazy-loading@2.0.1": "patches/markdown-it-image-lazy-loading@2.0.1.patch"
    }
  },
  "scripts": {
    "test:growth": "turbo run test:growth --concurrency=1",
    "test:upload:integration": "node --env-file=tests/integration/maxio-upload/fixture.env --import tsx tests/integration/maxio-upload/integration.ts",
    "test:upload:browser": "node tests/integration/maxio-upload/browser.mjs",
    "test:reader-search:browser": "node tests/integration/reader-search-keystrokes/browser.mjs",
    "test:reader-language-paths:browser": "node scripts/reader-language-paths-evidence.mjs",
    "test:reader-navigation:browser": "node tests/integration/reader-navigation/browser.mjs",
    "test:reader-deferred-controls:browser": "node tests/integration/reader-deferred-controls/browser.mjs",
    "test:reader-video-embeds:browser": "node tests/integration/reader-video-embeds/browser.mjs",
    "test:editor-video-blocks:browser": "node --env-file=.env --import tsx tests/integration/editor-video-blocks/browser.mjs",
    "test:capture-network:browser": "node tests/integration/lib/capture-network.browser.mjs",
    "test:settings:browser": "node tests/integration/settings-leave-guard/browser.mjs",
    "test:ds:forced-colors": "node tests/integration/design-system/forced-colors.mjs",
    "build": "turbo run build",
    "build:server": "turbo run build -F @nibleaf/server...",
    "build:worker": "turbo run build -F @nibleaf/worker...",
    "build:app": "turbo run build -F @nibleaf/app...",
    "dev": "node scripts/dev.mjs",
    "dev:full": "node scripts/dev.mjs full",
    "dev:server": "turbo watch dev -F @nibleaf/server...",
    "dev:app": "turbo watch dev -F @nibleaf/app...",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/container-commands.test.mjs scripts/release-notes.test.mjs scripts/email-runtime.test.mjs scripts/ui-primitives.test.mjs scripts/server-i18n-imports.test.mjs scripts/service-signals.test.mjs scripts/backup.test.mjs scripts/self-host-setup.test.mjs scripts/self-host-release.test.mjs scripts/vitest-env.test.mjs scripts/vitest-cache.test.mjs tests/integration/lib/capture-env.test.mjs && turbo run test",
    "check:dead-code": "knip --include files,dependencies,exports,types,duplicates,unlisted --no-config-hints",
    "check:react": "react-doctor --project @nibleaf/app,@nibleaf/admin --no-dead-code --no-supply-chain --no-score --blocking error",
    "release:notes": "node scripts/release-notes.mjs",
    "release:check": "node --test scripts/coolify-release-probes.test.mjs scripts/coolify-env-literal.test.mjs scripts/check-source-ci.test.mjs scripts/publish-built-image.test.mjs scripts/self-host-safety.test.mjs scripts/self-host-contract.test.mjs && node scripts/check-release-contract.mjs",
    "self-host:check": "node scripts/self-host-release.mjs",
    "self-host:smoke": "node scripts/self-host-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs && node scripts/check-container-commands.mjs",
    "theme-repository:fixture": "tsx scripts/theme-repository-fixture.ts",
    "db:generate": "pnpm --filter @nibleaf/database generate",
    "db:migrate": "pnpm --filter @nibleaf/database migrate:dev",
    "db:deploy": "pnpm --filter @nibleaf/database migrate:deploy",
    "db:push": "pnpm --filter @nibleaf/database push",
    "db:seed": "pnpm --filter @nibleaf/server seed",
    "db:studio": "pnpm --filter @nibleaf/database studio",
    "analytics:migrate": "pnpm --filter @nibleaf/clickhouse migrate",
    "analytics:backfill": "tsx scripts/analytics-migration.ts backfill",
    "analytics:reconcile": "tsx scripts/analytics-migration.ts reconcile",
    "analytics:rollback": "tsx scripts/analytics-migration.ts rollback",
    "release:notes:engine": "pnpm dlx changelogithub@14.0.0",
    "release:notes:dry": "node scripts/release-notes.mjs --dry"
  },
  "dependencies": {
    "@nibleaf/tsconfig": "workspace:*",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@nibleaf/clickhouse": "workspace:*",
    "@nibleaf/database": "workspace:*",
    "knip": "6.44.1",
    "libpg-query": "17.7.4",
    "playwright-core": "^1.65.0",
    "react-doctor": "0.9.22",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vitest": "^5.1.0"
  }
}
